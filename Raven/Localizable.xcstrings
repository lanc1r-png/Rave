{
  "sourceLanguage": "en",
  "strings": {
    "Chapters": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Главы"
          }
        }
      }
    },
    "Close": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрыть"
          }
        }
      }
    },
    "Chapter %lld": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Глава %lld"
          }
        }
      }
    },
    "Playing": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Играет"
          }
        }
      }
    },
    "Adding to library…": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавление в библиотеку…"
          }
        }
      }
    },
    "Scanning library…": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сканирование библиотеки…"
          }
        }
      }
    },
    "Library Error": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ошибка библиотеки"
          }
        }
      }
    },
    "OK": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ОК"
          }
        }
      }
    },
    "Library": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Библиотека"
          }
        }
      }
    },
    "Add folder": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавить папку"
          }
        }
      }
    },
    "About Raven": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "О приложении Raven"
          }
        }
      }
    },
    "Raven is a local-first audiobook player. Import folders of audio and keep everything on your device.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Raven — плеер аудиокниг, который хранит всё на вашем устройстве. Импортируйте папки с аудио и слушайте без интернета."
          }
        }
      }
    },
    "Privacy Policy": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Политика конфиденциальности"
          }
        }
      }
    },
    "Raven does not collect account data or upload your library. Audiobooks, playback progress, and bookmarks stay on this device.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Raven не собирает данные аккаунта и не выгружает вашу библиотеку. Аудиокниги, прогресс и закладки остаются на этом устройстве."
          }
        }
      }
    },
    "Bedtime Mode": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Режим сна"
          }
        }
      }
    },
    "Timer Duration": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Длительность таймера"
          }
        }
      }
    },
    "Playback will automatically fade out and pause after the selected duration.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Воспроизведение плавно затихнет и остановится через выбранное время."
          }
        }
      }
    },
    "Appearance": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оформление"
          }
        }
      }
    },
    "Choose Light or Dark, or match your iPhone’s system setting.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите светлую или тёмную тему либо следуйте настройке iPhone."
          }
        }
      }
    },
    "Import Folders": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Импорт папок"
          }
        }
      }
    },
    "Version %@": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Версия %@"
          }
        }
      }
    },
    "Settings": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройки"
          }
        }
      }
    },
    "Done": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Готово"
          }
        }
      }
    },
    "Search your library once you add audiobooks.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поиск по библиотеке появится, когда вы добавите аудиокниги."
          }
        }
      }
    },
    "Search": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поиск"
          }
        }
      }
    },
    "Rename bookmark": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переименовать закладку"
          }
        }
      }
    },
    "Note": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заметка"
          }
        }
      }
    },
    "Save": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранить"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отмена"
          }
        }
      }
    },
    "Close player": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрыть плеер"
          }
        }
      }
    },
    "Now Playing": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейчас играет"
          }
        }
      }
    },
    "Bookmarks": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закладки"
          }
        }
      }
    },
    "No bookmarks yet. Tap “Add bookmark” to save your place.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закладок пока нет. Нажмите «Добавить закладку», чтобы сохранить место."
          }
        }
      }
    },
    "Bedtime mode": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Режим сна"
          }
        }
      }
    },
    "Folder missing from library": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Папка отсутствует в библиотеке"
          }
        }
      }
    },
    "Unknown Author": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Неизвестный автор"
          }
        }
      }
    },
    "Folder missing": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Папка отсутствует"
          }
        }
      }
    },
    "Your Library is Empty": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Библиотека пуста"
          }
        }
      }
    },
    "Import your audiobooks from the Files app to get started.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы начать, импортируйте аудиокниги из приложения «Файлы»."
          }
        }
      }
    },
    "Add Folder": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавить папку"
          }
        }
      }
    },
    "Add bookmark": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавить закладку"
          }
        }
      }
    },
    "Rename": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переименовать"
          }
        }
      }
    },
    "Delete": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить"
          }
        }
      }
    },
    "Mark as finished": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отметить прослушанным"
          }
        }
      }
    },
    "Mark as unfinished": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Снять отметку «прослушано»"
          }
        }
      }
    },
    "Finished": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прослушано"
          }
        }
      }
    },
    "%lld%% completed": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прослушано %lld%%"
          }
        }
      }
    },
    "%@ remaining": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Осталось %@"
          }
        }
      }
    },
    "System": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Системная"
          }
        }
      }
    },
    "Light": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Светлая"
          }
        }
      }
    },
    "Dark": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тёмная"
          }
        }
      }
    },
    "%lldm": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld мин"
          }
        }
      }
    },
    "%lldh %lldm": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld ч %lld мин"
          }
        }
      }
    },
    "Could not read the selected folder.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось прочитать выбранную папку."
          }
        }
      }
    },
    "No supported audio files found in this folder.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этой папке нет поддерживаемых аудиофайлов."
          }
        }
      }
    },
    "This audiobook is already in your library as \"%@\".": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта аудиокнига уже есть в библиотеке под названием «%@»."
          }
        }
      }
    },
    "Please select a folder containing audio files.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите папку с аудиофайлами."
          }
        }
      }
    },
    "This audiobook folder is no longer in your Raven library.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Папки этой аудиокниги больше нет в библиотеке Raven."
          }
        }
      }
    },
    "Could not access this audiobook. Add it to the Raven folder in Files.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось открыть аудиокнигу. Добавьте её в папку Raven в приложении «Файлы»."
          }
        }
      }
    },
    "The book folder is no longer accessible. Re-import the folder from Files.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Папка с книгой больше недоступна. Импортируйте её заново из «Файлов»."
          }
        }
      }
    },
    "Could not access the book folder. Check Files permissions.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось открыть папку с книгой. Проверьте разрешения для «Файлов»."
          }
        }
      }
    },
    "%lld chapters": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld chapter"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld chapters"
                }
              }
            }
          }
        },
        "ru": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld глава"
                }
              },
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld главы"
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld глав"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld главы"
                }
              }
            }
          }
        }
      }
    }
  },
  "version": "1.0"
}